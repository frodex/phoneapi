<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <Preference
        android:key="intro"
        android:persistent="false"
        android:selectable="false"
        android:summary="@string/intro" />
    <SwitchPreferenceCompat
        android:key="helper"
        android:persistent="false"
        android:title="@string/helper_switch" />
    <SwitchPreferenceCompat
        android:key="wireless"
        android:persistent="false"
        android:summary="@string/wireless_summary"
        android:title="@string/wireless_switch" />
    <Preference
        android:key="wireless_settings"
        android:persistent="false"
        android:title="@string/wireless_switch" />
    <Preference
        android:key="pair"
        android:title="@string/wireless_pair" />
    <ListPreference
        android:key="screenCleanupOnRelease"
        android:persistent="false"
        android:title="@string/cleanup_title"
        android:entries="@array/cleanup_entries"
        android:entryValues="@array/cleanup_values" />
    <PreferenceCategory
        android:key="tokens"
        android:title="@string/tokens_title" />
</PreferenceScreen>
